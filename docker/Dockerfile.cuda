# syntax=docker/dockerfile:1.7

# ---------- builder ----------
# Full Ubuntu + CUDA 12.8 with build toolchain; only the virtualenv at /opt/venv
# survives into the runtime image.
FROM nvidia/cuda:12.8.0-cudnn-runtime-ubuntu22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PIP_NO_CACHE_DIR=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:/usr/local/bin:/usr/bin:/bin

RUN set -eux; \
    echo 'Acquire::Retries "5";' > /etc/apt/apt.conf.d/80-retries; \
    echo 'Acquire::http::Timeout "30";' > /etc/apt/apt.conf.d/99-timeout; \
    echo 'Acquire::https::Timeout "30";' >> /etc/apt/apt.conf.d/99-timeout; \
    for i in 1 2 3 4 5; do \
        apt-get update && break; \
        echo "apt-get update failed (attempt $i/5), sleeping..."; \
        sleep $((i * 15)); \
    done; \
    apt-get install -y --no-install-recommends \
        python3.10 \
        python3.10-venv \
        python3.10-dev \
        python3-pip \
        git \
        git-lfs \
        build-essential \
        ca-certificates; \
    git lfs install; \
    rm -rf /var/lib/apt/lists/*

RUN python3.10 -m venv "$VIRTUAL_ENV" \
    && pip install --upgrade pip setuptools wheel

# PyTorch with CUDA 12.8 wheels
RUN pip install --index-url https://download.pytorch.org/whl/cu128 \
        torch==2.8.0 torchaudio==2.8.0

COPY index-tts /opt/index-tts
RUN pip install /opt/index-tts \
    && pip install hf_transfer huggingface_hub

COPY docker/requirements.api.txt /tmp/requirements.api.txt
RUN pip install -r /tmp/requirements.api.txt \
 && find "$VIRTUAL_ENV" -type d -name '__pycache__' -prune -exec rm -rf {} + \
 && find "$VIRTUAL_ENV" -type d -name 'tests' -prune -exec rm -rf {} + \
 && find "$VIRTUAL_ENV" -type f -name '*.pyc' -delete


# ---------- runtime ----------
# Slim CUDA runtime — no build-essential, no git-lfs, no python3-dev.
FROM nvidia/cuda:12.8.0-cudnn-runtime-ubuntu22.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    HF_HOME=/root/.cache/huggingface \
    HF_HUB_ENABLE_HF_TRANSFER=1 \
    PIP_NO_CACHE_DIR=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:/usr/local/bin:/usr/bin:/bin \
    INDEXTTS_REPO_DIR=/opt/index-tts \
    PYTHONPATH=/opt/index-tts:/opt/api

RUN set -eux; \
    echo 'Acquire::Retries "5";' > /etc/apt/apt.conf.d/80-retries; \
    echo 'Acquire::http::Timeout "30";' > /etc/apt/apt.conf.d/99-timeout; \
    echo 'Acquire::https::Timeout "30";' >> /etc/apt/apt.conf.d/99-timeout; \
    for i in 1 2 3 4 5; do \
        apt-get update && break; \
        echo "apt-get update failed (attempt $i/5), sleeping..."; \
        sleep $((i * 15)); \
    done; \
    apt-get install -y --no-install-recommends \
        python3.10 \
        libpython3.10 \
        ffmpeg \
        libsndfile1 \
        ca-certificates; \
    ln -sf /usr/bin/python3.10 /usr/local/bin/python; \
    ln -sf /usr/bin/python3.10 /usr/local/bin/python3; \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /opt/index-tts /opt/index-tts

WORKDIR /opt/api
COPY app /opt/api/app
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

VOLUME ["/voices", "/root/.cache"]
EXPOSE 8000
ENTRYPOINT ["/entrypoint.sh"]
CMD ["uvicorn", "app.server:app", "--host", "0.0.0.0", "--port", "8000"]
